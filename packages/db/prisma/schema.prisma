// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SectionSlug {
  printing
  mementoes
  corporate_gifts
}

model Section {
  id        String      @id @default(cuid())
  slug      SectionSlug @unique
  label     String
  tagline   String
  heroSlides HeroSlide[]
  services  Service[]
  categories Category[]
  gallery   GalleryItem[]
  testimonials Testimonial[]
  about     AboutContent?
  whyChooseUs WhyChooseContent?
  contactSubmissions ContactSubmission[]
  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
}

model HeroSlide {
  id            String  @id @default(cuid())
  section       Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId     String
  image         String
  eyebrow       String
  heading       String
  headingAccent String
  intro         String
  order         Int     @default(0)
}

model Service {
  id          String  @id @default(cuid())
  section     Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId   String
  title       String
  description String
  order       Int     @default(0)
}

model Category {
  id             String        @id @default(cuid())
  section        Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId      String
  image          String
  title          String
  description    String
  order          Int           @default(0)
  subCategories  SubCategory[]
}

model SubCategory {
  id          String   @id @default(cuid())
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  image       String
  title       String
  description String
  order       Int      @default(0)
}

model GalleryItem {
  id        String  @id @default(cuid())
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String
  image     String
  caption   String?
  order     Int     @default(0)
}

model Testimonial {
  id        String  @id @default(cuid())
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String
  author    String
  quote     String
  order     Int     @default(0)
}

model AboutContent {
  id        String       @id @default(cuid())
  section   Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String       @unique
  eyebrow   String       @default("About Us")
  heading   String
  body      String
  stats     AboutStat[]
  images    AboutImage[]
  updatedAt DateTime     @updatedAt
}

model AboutStat {
  id             String       @id @default(cuid())
  aboutContent   AboutContent @relation(fields: [aboutContentId], references: [id], onDelete: Cascade)
  aboutContentId String
  value          String
  label          String
  order          Int          @default(0)
}

enum ImageSide {
  left
  right
}

model AboutImage {
  id             String       @id @default(cuid())
  aboutContent   AboutContent @relation(fields: [aboutContentId], references: [id], onDelete: Cascade)
  aboutContentId String
  url            String
  side           ImageSide
  order          Int          @default(0)
}

model WhyChooseContent {
  id            String             @id @default(cuid())
  section       Section            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId     String             @unique
  eyebrow       String             @default("Why Choose Us")
  headingPrefix String             @default("Built on")
  headingAccent String             @default("craft")
  headingSuffix String             @default(", run like a press.")
  intro         String             @default("Four decades-deep reasons businesses trust Arjun Printing Press with every run, from proof to delivery.")
  features      WhyChooseFeature[]
  updatedAt     DateTime           @updatedAt
}

model WhyChooseFeature {
  id          String           @id @default(cuid())
  content     WhyChooseContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  contentId   String
  icon        String           @default("Award")
  title       String
  description String
  order       Int              @default(0)
}

model ContactSubmission {
  id                   String   @id @default(cuid())
  section              Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId            String
  name                 String
  email                String
  phone                String
  serviceType          String
  quantity             String
  details              String
  paperSpec            String?
  eventDate            String?
  brandingRequirements String?
  read                 Boolean  @default(false)
  createdAt            DateTime @default(now())
}
